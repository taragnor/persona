<div class="changes">
	<span class="change-target">
		{{getTokenAccName change.actor}}:
	</span>
	{{#each change.damage as |damage|}}
	<span class="damage-element">
		<span class="tooltip">
			{{#if (lt damage.hpChange 0)}}
			<span class="damage">{{abs damage.hpChange}}</span> {{displayDamageIcon damage.damageType}}
			{{else}}
			<span class="healing">{{abs damage.hpChange}}</span> {{displayDamageIcon damage.damageType}}
			{{/if}}
			{{> "systems/persona/parts/damage-calc-display.hbs" damage=damage}}
		</span>
		<span>
			{{#if damage.resisted}}
			<span class="resisted">(Resist)</span>
			{{/if}}
		</span>
		<span>
			{{#if damage.weakness}}
			<span class="resisted">(Weak)</span>
			{{/if}}
		</span>
	</span>
	{{/each}}

  {{#each change.addStatus as |status|}}
  +{{displayStatusIcon status.id}}
  {{/each}}
  {{#each change.removeStatus as |status|}}
  -{{displayStatusIcon status.id}}
  {{/each}}
  {{#each change.otherEffects as |effect|}}
			{{> "systems/persona/parts/other-effect.hbs" effect=effect}}
	{{/each}}
</div>

