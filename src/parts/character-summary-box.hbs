<div class="character-card {{#if combatant.isDefeated}} defeated {{/if}} {{#if (isDead combatant.actor)}} dead {{/if}} {{#if (eq combatant highlight)}} highlighted{{/if}}" data-target-id="{{token.id}}">
  <div class="portrait">
    <img src="{{combatant.img}}" alt="Character Portrait">
  </div>
  <div class="character-info">
    <div class="character-name">
      {{combatant.name}}
    </div>

    <div class="resource-bar hp">
      <div class="fill" style="width: {{divideTracker combatant.actor.system.combat.hpTracker}}%;"></div>
      {{#if (scanLevelgte combatant.actor 2)}}
      <span class="label">HP {{combatant.actor.system.combat.hpTracker.value}} / {{combatant.actor.system.combat.hpTracker.max}}</span>
      {{/if}}
    </div>

        {{#if combatant.actor.system.combat.mp.max}}
        <div class="resource-bar mp">
          <div class="fill" style="width: {{divideTracker combatant.actor.system.combat.mp}}%;"></div>
          <span class="label">MP {{combatant.actor.system.combat.mp.value}} / {{combatant.actor.system.combat.mp.max}}</span>
        </div>
        {{/if}}

        {{#if combatant.actor.energy}}
        <div class="resource-bar mp">
          <div class="fill" style="width: {{divideTracker combatant.actor.system.combat.energy}}%;"></div>
          {{#if (scanLevelgte character.actor 2)}}
          <span class="label">En {{combatant.actor.energy}} / {{combatant.actor.maxEnergy}}</span>
          {{/if}}
        </div>
        {{/if}}
  </div>

</div>
